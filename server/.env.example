# ---------------------------------------------------------------------------
# NyayaPath - live model configuration
#
# Copy this file to .env and fill in a real key:
#     server\.env
#
# .env is git-ignored. NEVER commit a real key, never put the key in web/,
# and never expose it through a VITE_ variable - Vite inlines VITE_* values
# into the client bundle and they would be visible in the browser.
#
# With nothing set here the app runs in deterministic mode and every feature
# still works. See .env.example for placeholder values only.
# ---------------------------------------------------------------------------

# Set to false to force deterministic mode even when a key is present.
LLM_ENABLED=true

# groq | openai | generic  (generic = any OpenAI-compatible /chat/completions URL)
LLM_PROVIDER=groq

# Your real provider key. Server-side only.
LLM_API_KEY=replace-with-your-real-key

# Model id must be one your provider actually serves.
LLM_MODEL=openai/gpt-oss-120b

# Leave unset for the provider default shown above.
# Groq:      https://api.groq.com/openai/v1
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Request handling
LLM_TIMEOUT_MS=20000
LLM_MAX_ATTEMPTS=2

# Set to false if your provider does not support response_format=json_object
LLM_JSON_MODE=true

# Lawyer directory
# Keep false in production. The bundled profiles are fictional demo data and are
# returned only when this is explicitly true. They are always labelled as demo.
LAWYER_DIRECTORY_DEMO=false
